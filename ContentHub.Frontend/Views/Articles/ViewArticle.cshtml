@model ContentHub.Frontend.Tables.Article

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
}

<div class="container mt-5">
 
    <h2 class="text-center mb-4 display-4">@Model.Title</h2>
    <p class="text-muted text-center">
        @Model.Category?.CategoryName • Published: @Model.PublishDate.ToString("yyyy-MM-dd")
    </p>

   
    <div class="card shadow-lg border-light rounded-3 mb-4">
        <div class="card-body">
         
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <div class="mb-3 text-center">
                    <img src="@Url.Content(Model.PhotoPath)" alt="Article Photo" class="img-fluid rounded-3" style="max-height: 400px; object-fit: cover;" />
                </div>
            }

           
            <p class="card-text">@Model.Content</p>
        </div>
    </div>

  
    <div class="text-center">
        <a href="@Url.Action("ArticlePage", "Articles")" class="btn btn-outline-secondary btn-lg me-3">
            <i class="bi bi-arrow-left-circle"></i> Back to Articles
        </a>
        <a href="@Url.Action("Edit", "Articles", new { id = Model.ArticleId })" class="btn btn-outline-warning btn-lg">
            <i class="bi bi-pencil"></i> Edit Article
        </a>

        
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.ArticleId" method="post" class="d-inline-block">
            <button type="submit" class="btn btn-outline-danger btn-lg">
                <i class="bi bi-trash"></i> Delete Article
            </button>
        </form>
    </div>

   
    <hr class="my-4">
    <h4>Comments</h4>
    @if (Model.Comments?.Any() == true)
    {
        <ul class="list-group">
            @foreach (var comment in Model.Comments)
            {
                <li class="list-group-item">
                    <strong>@comment.AuthorId:</strong> @comment.Content
                </li>
            }
        </ul>
    }
    else
    {
        <p>No comments yet. Be the first to comment!</p>
    }

 
    <hr class="my-4">
    <h4>Add a Comment</h4>
    <form asp-action="AddComment" asp-controller="Articles" method="post">
        <input type="hidden" name="articleId" value="@Model.ArticleId" />
        <div class="mb-3">
            <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">💬 Add Comment</button>
    </form>
</div>
