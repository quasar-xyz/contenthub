@using Microsoft.EntityFrameworkCore
@model IEnumerable<ContentHub.Frontend.Tables.Article>

@{
    ViewBag.Title = "Articles";
    Layout = "_Layout";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Latest Articles</h2>

    <div class="row justify-content-center">
        @foreach (var article in Model)
        {
            <div class="col-md-8">
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@article.Title</h5>
                        <p class="text-muted">@article.Category?.CategoryName • @article.PublishDate.ToString("yyyy-MM-dd")</p>
                        <p class="card-text">@article.Content</p>

                        <div class="d-flex justify-content-between align-items-center">
                          
                            <form asp-action="Like" asp-controller="Articles" asp-route-articleId="@article.ArticleId" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success">👍 Like</button>
                            </form>

                            
                            <span id="like-count-@article.ArticleId">@article.Likes?.Count() Likes</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
