@using Microsoft.EntityFrameworkCore
@model IEnumerable<ContentHub.Frontend.Tables.Article>

@{
    ViewBag.Title = "Articles";
    Layout = "_Layout";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-5">
    <h2 class="text-center mb-4 display-4">Latest Articles</h2>

    
    <div class="text-end mb-4">
        <a href="@Url.Action("Create", "Articles")" class="btn btn-primary btn-lg">+ Create New Article</a>
    </div>

    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var article in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-lg border-light rounded-3">
                    <div class="card-body">

                        
                        <h5 class="card-title text-primary fw-bold fs-4">@article.Title</h5>

                        
                        <p class="card-text text-muted">
                            @article.Category?.CategoryName •
                            <span class="fw-light">@article.PublishDate.ToString("yyyy-MM-dd")</span>
                        </p>

                        
                        @if (!string.IsNullOrEmpty(article.PhotoPath))
                        {
                            <div class="mb-3 text-center">
                                <img src="@Url.Content(article.PhotoPath)" alt="Article Photo" class="img-fluid rounded-3" style="max-height: 250px; object-fit: cover;" />
                            </div>
                        }

                        
                        <p class="card-text text-truncate" style="max-height: 150px; overflow: hidden;">@article.Content</p>

                    </div>

                    
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center">


                        <form asp-action="Like" asp-controller="Articles" asp-route-articleId="@article.ArticleId" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                                <i class="bi bi-hand-thumbs-up"></i> Like
                            </button>
                        </form>

                        
                        <span id="like-count-@article.ArticleId" class="text-muted">
                            @article.Likes?.Count() Likes
                        </span>

                        
                        <a asp-action="ViewArticle" asp-controller="Articles" asp-route-id="@article.ArticleId" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-eye"></i> View
                        </a>

                        
                        <form asp-action="DeleteConfirmed" asp-route-id="@article.ArticleId" method="post" class="d-inline-block">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
