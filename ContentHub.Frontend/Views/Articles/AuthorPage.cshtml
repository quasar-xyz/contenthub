@using Microsoft.AspNetCore.Identity
@model dynamic

@{
    Layout = "_Layout";
}

@{
    var author = ViewBag.Author as IdentityUser;
    var articles = ViewBag.Articles as List<ContentHub.Frontend.Tables.Article>;
    var comments = ViewBag.Comments as List<ContentHub.Frontend.Tables.Comment>;
    var categories = ViewBag.Categories as List<ContentHub.Frontend.Tables.Category>; 
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container">
    <div class="row">
        <div class="col-md-3">
            <h3>Categories</h3>
            <div class="list-group">
                @if (categories != null && categories.Any())
                {
                    @foreach (var category in categories)
                    {
                        <a href="@Url.Action("CategoryPage", "Articles", new { categoryName = category.CategoryName })" class="list-group-item list-group-item-action">
                            @category.CategoryName
                        </a>
                    }
                }
                else
                {
                    <p>No categories available.</p>
                }
            </div>

            <a href="@Url.Action("CreateCommunity", "Articles")" class="btn btn-primary mt-3">Create New Community</a>
        </div>
        
        <div class="col-md-9">
            <h2 class="text-center mb-4">@author.UserName</h2>
            <p class="text-center mb-4">All articles and comments by @author.UserName</p>
            
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Articles by @author.UserName</h3>
                </div>
                <div class="card-body">
                    @if (articles != null && articles.Any())
                    {
                        <ul class="list-group">
                            @foreach (var article in articles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a href="@Url.Action("ViewArticle", "Articles", new { id = article.ArticleId })" class="text-decoration-none text-dark">
                                        @article.Title
                                    </a>
                                    <span class="badge bg-secondary">@article.PublishDate.ToString("yyyy-MM-dd")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No articles available.</p>
                    }
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Comments by @author.UserName</h3>
                </div>
                <div class="card-body">
                    @if (comments != null && comments.Any())
                    {
                        <ul class="list-group">
                            @foreach (var comment in comments)
                            {
                                <li class="list-group-item">
                                    <strong>@comment.Article.Title</strong>: <em>@comment.Content</em>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No comments available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
